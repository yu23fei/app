<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/background">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/spacing_medium">

        <TextView
            android:id="@+id/tv_welcome"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/home_welcome"
            android:textColor="@color/text_primary"
            android:textSize="@dimen/text_size_xlarge"
            android:textStyle="bold"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/tv_slogan"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="@string/home_slogan"
            android:textColor="@color/text_secondary"
            android:textSize="@dimen/text_size_medium"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_welcome" />

        <com.google.android.material.card.MaterialCardView
            android:id="@+id/card_trip_form"
            style="@style/Widget.Yuyu.Card"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/spacing_large"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/tv_slogan">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/spacing_medium">

                <!-- 目的地 -->
                <TextView
                    android:id="@+id/tv_destination_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/label_destination"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/til_destination"
                    style="@style/Widget.Yuyu.TextInputLayout"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="4dp"
                    android:hint="@string/hint_destination"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_destination_label">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/et_destination"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />

                </com.google.android.material.textfield.TextInputLayout>

                <!-- 快捷填充按钮 -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fill_chongqing"
                    style="@style/Widget.Material3.Button.OutlinedButton.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:text="@string/quick_fill_chongqing"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/til_destination" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fill_chengdu"
                    style="@style/Widget.Material3.Button.OutlinedButton.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/quick_fill_chengdu"
                    app:layout_constraintStart_toEndOf="@id/btn_fill_chongqing"
                    app:layout_constraintTop_toBottomOf="@id/til_destination" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_fill_xian"
                    style="@style/Widget.Material3.Button.OutlinedButton.Small"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="8dp"
                    android:text="@string/quick_fill_xian"
                    app:layout_constraintStart_toEndOf="@id/btn_fill_chengdu"
                    app:layout_constraintTop_toBottomOf="@id/til_destination" />

                <!-- 出行天数和预算 -->
                <LinearLayout
                    android:id="@+id/layout_days_budget"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:orientation="horizontal"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/btn_fill_chongqing">

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_days"
                        style="@style/Widget.Yuyu.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_days"
                        app:endIconMode="dropdown_menu">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_days"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                    <Space
                        android:layout_width="@dimen/spacing_medium"
                        android:layout_height="wrap_content" />

                    <com.google.android.material.textfield.TextInputLayout
                        android:id="@+id/til_budget"
                        style="@style/Widget.Yuyu.TextInputLayout"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:hint="@string/label_budget"
                        app:endIconMode="none">

                        <com.google.android.material.textfield.TextInputEditText
                            android:id="@+id/et_budget"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:inputType="number" />

                    </com.google.android.material.textfield.TextInputLayout>

                </LinearLayout>

                <!-- 早八人模式开关 -->
                <com.google.android.material.switchmaterial.SwitchMaterial
                    android:id="@+id/switch_early_bird"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:checked="false"
                    android:text="@string/early_bird_mode"
                    android:textColor="@color/text_primary"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/layout_days_budget" />

                <TextView
                    android:id="@+id/tv_early_bird_desc"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:text="@string/early_bird_mode_desc"
                    android:textColor="@color/text_hint"
                    android:textSize="@dimen/text_size_small"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toEndOf="@id/switch_early_bird"
                    app:layout_constraintTop_toTopOf="@id/switch_early_bird" />

                <!-- 出行偏好 -->
                <TextView
                    android:id="@+id/tv_preference_label"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="24dp"
                    android:text="@string/travel_preference"
                    android:textColor="@color/text_primary"
                    android:textSize="@dimen/text_size_medium"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/switch_early_bird" />

                <com.google.android.material.chip.ChipGroup
                    android:id="@+id/chip_group_preferences"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    app:chipSpacing="8dp"
                    app:singleSelection="false"
                    app:selectionRequired="false"
                    app:singleLine="true"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/tv_preference_label">

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_foodie"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_foodie" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_photo"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_photo" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_history"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_history" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_nature"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_nature" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_shopping"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_shopping" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_relax"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_relax" />

                    <com.google.android.material.chip.Chip
                        android:id="@+id/chip_nightlife"
                        style="@style/Widget.Yuyu.Chip.Choice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/pref_nightlife" />

                </com.google.android.material.chip.ChipGroup>

                <!-- 生成行程按钮 -->
                <Button
                    android:id="@+id/btn_generate_trip"
                    style="@style/Widget.Yuyu.Button.Primary"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/spacing_large"
                    android:text="@string/btn_start_trip"
                    android:textAllCaps="false"
                    app:layout_constraintEnd_toEndOf="parent"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@id/chip_group_preferences" />

            </androidx.constraintlayout.widget.ConstraintLayout>

        </com.google.android.material.card.MaterialCardView>

    </androidx.constraintlayout.widget.ConstraintLayout>
</androidx.core.widget.NestedScrollView>
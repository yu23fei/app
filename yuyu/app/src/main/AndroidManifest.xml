<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <application
        android:name=".App"
        android:allowBackup="true"
        android:dataExtractionRules="@xml/data_extraction_rules"
        android:fullBackupContent="@xml/backup_rules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.Yuyu"
        tools:targetApi="34">

        <!-- Splash Activity -->
        <activity
            android:name=".SplashActivity"
            android:exported="true"
            android:theme="@style/Theme.Yuyu.Splash">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Login Activity -->
        <activity
            android:name=".LoginActivity"
            android:exported="false"
            android:windowSoftInputMode="adjustResize|stateVisible" />

        <!-- Main Activity -->
<!--        -->
        <activity
            android:name=".MainActivity"
            android:exported="false" />

        <!-- Trip Detail Activity -->
        <activity
            android:name=".TripDetailActivity"
            android:exported="false" />

        <!-- Adjust Trip Activity -->
        <activity
            android:name=".AdjustTripActivity"
            android:exported="false" />

        <!-- Adjust Compare Activity -->
        <activity
            android:name=".AdjustCompareActivity"
            android:exported="false" />

        <!-- Application class for initialization -->
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_icon"
            android:resource="@drawable/ic_notification" />
        <meta-data
            android:name="com.google.firebase.messaging.default_notification_color"
            android:resource="@color/primary_color" />

    </application>
</manifest>